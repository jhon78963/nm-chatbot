# ──────────────────────────────────────────────
#  ENTORNO DE EJECUCIÓN — Novedades Maritex (NM)
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
API_PORT=8090
SERVICE_NAME=nm-chatbot

# ──────────────────────────────────────────────
#  BASE DE DATOS — PostgreSQL
# ──────────────────────────────────────────────
# Base de datos propia del chatbot (tablas chat_*)
# Crear con: createdb chatbot_db  (o dejar que prisma migrate la cree)
CHATBOT_DATABASE_URL=postgresql://postgres:password@localhost:5433/chatbot_db

# Base de datos principal del sistema NM (solo lectura: catálogo de productos y usuarios ERP)
# Dejar vacío si el chatbot no necesita consultar el catálogo de productos.
DATABASE_URL=postgresql://postgres:password@localhost:5433/nm_services

# ──────────────────────────────────────────────
#  IA — DEEPSEEK
# ──────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_REQUEST_TIMEOUT_MS=30000
# Timeout de experiencia al cliente WhatsApp. 0 desactiva el fallback (solo aplica el timeout HTTP).
DEEPSEEK_EXPERIENCE_TIMEOUT_MS=12000
# DEEPSEEK_TIMEOUT_FALLBACK_MESSAGE=Disculpa, estoy tardando un poco más de lo normal. En un momento te atiendo; también puedes repetir tu consulta.

# Path legado UPRIT. NM producción no usa Mongo: dejar en false / sin definir.
# CHATBOT_MONGO_ENABLED=false
# MONGODB_URI=
# MONGODB_DB_NAME=

# ──────────────────────────────────────────────
#  WEBHOOK — META WHATSAPP API (Cloud API / Malu)
# ──────────────────────────────────────────────
# Obtén estos valores en Meta Business Suite → WhatsApp → API Setup / Números de teléfono.
META_WHATSAPP_TOKEN=
# ID interno de Meta (NO es el número wa.me). Ej. 1061005937101730
META_WHATSAPP_PHONE_NUMBER_ID=
# WABA ID de la cuenta de negocio
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Número que ves en Meta como "Phone number" (+51 9…). Opcional aquí; si usas guest cart handoff,
# cópialo también en nm-backend/.env como WHATSAPP_HANDOFF_PHONE o META_WHATSAPP_DISPLAY_PHONE.
# META_WHATSAPP_DISPLAY_PHONE=+51 915 213 408
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v20.0
META_API_BASE_URL=https://graph.facebook.com

# ──────────────────────────────────────────────
#  SEGURIDAD
# ──────────────────────────────────────────────
WEBHOOK_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Mismo valor que JWT_SECRET del nm-backend (auth-service). SSO y login con credenciales ERP.
ERP_JWT_SECRET=
# En Docker (nm-deploy) se usa http://gateway:3000/api/v1. Local sin compose: http://localhost:3000/api/v1
AUTH_SERVICE_URL=http://localhost:3000/api/v1
# Producción: true — desactiva login con contraseña del panel chatbot
ERP_SSO_ONLY=false
CORS_ORIGINS=http://localhost:4200,http://localhost:5173,http://localhost:8080,http://localhost:3015,https://novedadesmaritex.net.pe,https://app.novedadesmaritex.net.pe
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ──────────────────────────────────────────────
#  NM — Tienda y panel admin
# ──────────────────────────────────────────────
STORE_URL=https://novedadesmaritex.net.pe
BOT_NAME=Malu
# Filtro estricto: solo mensajes con interés comercial claro (sin hola suelto). false = desactivar.
COMMERCIAL_INTEREST_FILTER_ENABLED=true
ADMIN_PANEL_URL=http://localhost:4200
# Producción: https://app.novedadesmaritex.net.pe
# En producción el panel solo carga dentro del iframe del ERP (ADMIN_EMBED_ONLY=true por defecto).
# ADMIN_EMBED_ONLY=false desactiva el bloqueo (útil para depurar el panel directo).
CHATBOT_ADMIN_URL=http://localhost:5173
# Producción: https://chatbot.novedadesmaritex.net.pe/admin
ADMIN_CORS_ORIGIN=http://localhost:8080
# Producción: https://app.novedadesmaritex.net.pe

# ──────────────────────────────────────────────
#  MEDIA
# ──────────────────────────────────────────────
MEDIA_STORAGE_PATH=./uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:8090/media
AUTO_REPLY_UNSUPPORTED_MEDIA="Recibí tu archivo. Por favor cuéntame en texto tu consulta o espera a un asesor."

# ──────────────────────────────────────────────
#  BOT
# ──────────────────────────────────────────────
INTERACTIVE_HANDOFF=false
MESSAGE_DEBOUNCE_MS=7000
HANDOFF_ASSIGN_AGENT_USERNAME=zero
HANDOFF_EXCLUDED_AGENT_USERNAMES=admin,maritex,zero.dev
HANDOFF_TRANSITION_MESSAGE=Te comunico con Maritex. En un momento te atiende 😊

# ──────────────────────────────────────────────
#  ECOMMERCE — Guest cart WhatsApp (service-to-service)
# ──────────────────────────────────────────────
ECOMMERCE_SERVICE_URL=http://localhost:3012
# Debe coincidir con nm-backend/.env INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY=nm-internal-dev-key-change-in-production
