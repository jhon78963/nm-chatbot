{
  "name": "nm-chatbot",
  "version": "1.0.0",
  "description": "Chatbot NM — Clean Architecture, DeepSeek AI, Meta WhatsApp, PostgreSQL (nm-backend-v3)",
  "author": "Novedades Maritex",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "prepare:prisma": "prisma generate --schema=./prisma/schema.prisma",
    "postinstall": "npm run prepare:prisma",
    "build": "npm run prepare:prisma && tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "start": "node --env-file=.env dist/main.js",
    "dev": "npm run build && node --env-file=.env --watch dist/main.js",
    "dev:src": "tsc --project tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "seed": "node --env-file=.env dist/infrastructure/database/mongodb/seeders/run-seeders.js",
    "seed:dev": "node --watch --env-file=.env --experimental-strip-types src/infrastructure/database/mongodb/seeders/run-seeders.ts",
    "admin:dev": "npm run dev --prefix admin",
    "admin:build": "npm run build --prefix admin",
    "build:all": "npm run build && npm run admin:build",
    "seed:agents": "node --env-file=.env deploy/seed-agent-passwords.mjs",
    "seed:admin": "node --env-file=.env deploy/create-admin-user.mjs",
    "sync:enrollment-dates": "node --env-file=.env deploy/sync-enrollment-dates.mjs",
    "docker:build": "docker compose build --no-cache",
    "docker:up": "docker compose up -d",
    "docker:up:build": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:down:v": "docker compose down -v",
    "docker:logs": "docker compose logs -f app",
    "docker:logs:obs": "docker compose logs -f loki promtail grafana",
    "docker:logs:all": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart app",
    "docker:exec": "docker compose exec app sh",
    "docker:nm:up": "docker compose -f docker-compose.nm.yml up -d",
    "docker:nm:down": "docker compose -f docker-compose.nm.yml down",
    "docker:nm:logs": "docker compose -f docker-compose.nm.yml logs -f app",
    "docker:nm:build": "docker compose -f docker-compose.nm.yml build --no-cache",
    "docker:nm:up:build": "docker compose -f docker-compose.nm.yml up -d --build",
    "create:agents:nm": "node --env-file=.env deploy/create-nm-agents.mjs",
    "verify:agents:erp": "node --env-file=.env deploy/create-nm-agents.mjs --verify-only",
    "reset:password": "node --env-file=.env deploy/reset-agent-password.mjs",
    "sync:products": "node --env-file=.env deploy/sync-products-to-context.mjs",
    "test:slug": "node --test deploy/product-slug.test.mjs",
    "test:pdp": "npm run build && node --test deploy/ecommerce-pdp-purchase.test.mjs",
    "test:b2b": "npm run build && node --test deploy/ecommerce-b2b-quote.test.mjs",
    "test:handoff": "npm run build && node --test deploy/whatsapp-cart-handoff.test.mjs",
    "test:cart-summary": "npm run build && node --test deploy/whatsapp-guest-cart-summary.test.mjs",
    "backup:chatbot": "node --env-file=.env deploy/backup-chatbot-config.mjs",
    "restore:chatbot": "node --env-file=.env deploy/restore-chatbot-config.mjs"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "handlebars": "^4.7.9",
    "jsonwebtoken": "^9.0.3",
    "@prisma/client": "5.22.0",
    "mongoose": "^8.16.1",
    "multer": "^2.2.0",
    "pino": "^9.7.0",
    "ws": "^8.21.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/handlebars": "^4.0.40",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^9.29.0",
    "pino-pretty": "^13.0.0",
    "prisma": "5.22.0",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  }
}
